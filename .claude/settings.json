{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/session-context.sh\"", "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/guard-paths.py\"", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/tex-lint.py\"", "timeout": 30 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 detail/scripts/*)",
      "Bash(python3 .claude/scripts/*)",
      "Bash(bash .claude/scripts/*)",
      "Bash(.claude/scripts/*)",
      "Bash(npm run --silent dict -- validate*)",
      "Bash(npm run --silent dict -- show*)",
      "Bash(npm run --silent dict -- search*)",
      "Bash(npm run --silent dict -- context*)",
      "Bash(npm run --silent dict -- form*)",
      "Bash(npm run --silent dict -- stats*)",
      "Bash(lualatex -interaction=nonstopmode *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Read(//Users/kohigen/Library/texmf/**)"
    ],
    "deny": [
      "Bash(git push*)"
    ]
  }
}
